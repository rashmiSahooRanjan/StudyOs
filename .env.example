# ==========================================
# StudyOS Production Environment Variables
# Copy this file to .env before starting:
#   cp .env.example .env
# ==========================================

# Host port where StudyOS will be accessible (default 80)
# Change to 8080, 3000, etc. if port 80 is already in use by another server
PORT=80

# Production application secret keys (Replace with strong random strings)
SECRET_KEY=change-this-to-a-very-long-random-secret-key-32-chars
JWT_SECRET_KEY=change-this-to-another-very-long-random-secret-jwt-key

# Database URL
# Default uses persistent SQLite volume in Docker:
DATABASE_URL=sqlite:////app/data/studyos.db

# Optional: To use PostgreSQL instead of SQLite, uncomment and set your connection string:
# DATABASE_URL=postgresql://postgres_user:postgres_password@db_host:5432/studyos
